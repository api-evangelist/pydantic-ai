          "info": {
            "name": "List Organizations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pydantic.dev/api/v1/v1/organizations/"
          },
          "docs": "List all organizations (self-hosted admin only).\n\nThis endpoint is deprecated and has moved to `/api/v1/instance/organizations/`."
        },
        {
          "info": {
            "name": "Create Organization",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://pydantic.dev/api/v1/v1/organizations/",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
